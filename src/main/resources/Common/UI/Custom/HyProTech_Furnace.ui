$C = "Common.ui";
@SlotSize = 46;

// Furnace page showing energy, status, progress, and input/output controls.
$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 420, Height: 380);

    #Title {
      Group {
        $C.@Title {
          @Text = "Electric Furnace";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group {
        LayoutMode: Top;
        Padding: (Top: 8, Left: 8, Right: 8);

        // Server-populated energy, consumption, status, and progress readouts.
        Label #FurnaceEnergy {
          Style: (
            FontSize: 16,
            RenderBold: true,
            TextColor: #d6cfb2
          );
          Text: "Energy: 0 J / 0 J (0.00 / 0.00 Wh)";
        }

        Label #FurnaceConsumption {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Padding: (Top: 4);
          Text: "Consumption: 0 W";
        }

        Label #FurnaceStatus {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Padding: (Top: 4);
          Text: "Status: OFF";
        }

        Label #FurnaceProgress {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Padding: (Top: 4);
          Text: "Progress: 0%";
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 10);

          Group {
            Anchor: (Width: 120);
            LayoutMode: Top;

            Label {
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                RenderUppercase: true
              );
              Text: "Input";
            }

            // Input slot button with a non-interactive icon and quantity overlay.
            ItemSlotButton #InputButton {
              Anchor: (Width: @SlotSize, Height: @SlotSize, Top: 6);
              LayoutMode: Full;

              ItemSlot #InputSlot {
                Anchor: (Full: 0);
                ShowQualityBackground: false;
                HitTestVisible: false;
              }

              Group {
                LayoutMode: Right;
                Anchor: (Width: @SlotSize, Top: 28);

                Label #InputQty {
                  Style: (
                    FontSize: 12,
                    HorizontalAlignment: End,
                    TextColor: #ffffff
                  );
                  HitTestVisible: false;
                  Text: "";
                }
              }
            }
          }

          Group {
            Anchor: (Width: 16);
          }

          Group {
            Anchor: (Width: 120);
            LayoutMode: Top;

            Label {
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                RenderUppercase: true
              );
              Text: "Output";
            }

            // Output slot button with a non-interactive icon and quantity overlay.
            ItemSlotButton #OutputButton {
              Anchor: (Width: @SlotSize, Height: @SlotSize, Top: 6);
              LayoutMode: Full;

              ItemSlot #OutputSlot {
                Anchor: (Full: 0);
                ShowQualityBackground: false;
                HitTestVisible: false;
              }

              Group {
                LayoutMode: Right;
                Anchor: (Width: @SlotSize, Top: 28);

                Label #OutputQty {
                  Style: (
                    FontSize: 12,
                    HorizontalAlignment: End,
                    TextColor: #ffffff
                  );
                  HitTestVisible: false;
                  Text: "";
                }
              }
            }
          }
        }

        Group {
          LayoutMode: Top;
          Padding: (Top: 12);

          // Actions open furnace storage and toggle its power state.
          $C.@TextButton #OpenInventory {
            Anchor: (Left: 0, Right: 0);
            Text: "Open Furnace Storage";
          }

          Group {
            Anchor: (Height: 6);
          }

          $C.@TextButton #FurnaceToggle {
            Anchor: (Left: 0, Right: 0);
            Text: "Power: OFF";
          }
        }
      }
    }
  }
}

$C.@BackButton {}
