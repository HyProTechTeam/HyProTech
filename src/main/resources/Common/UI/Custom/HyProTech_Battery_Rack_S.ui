$C = "Common.ui";
@ReqSlotSize = 32;

// Battery page; Java page logic fills the fields and handles actions.
$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 440, Height: 600);

    #Title {
      Group {
        $C.@Title {
          @Text = "Battery";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group {
        LayoutMode: Top;
        Padding: (Top: 8, Left: 8, Right: 8);

        // Current tier or network status values appear at the top.
        Label #BatteryTier {
          Style: (
            FontSize: 16,
            RenderBold: true,
            TextColor: #d6cfb2
          );
          Text: "Tier: Basic";
        }

        Label #BatteryEnergy {
          Style: (
            FontSize: 13,
            TextColor: #96a9be,
            Wrap: true
          );
          Anchor: (Left: 0, Right: 0);
          Padding: (Top: 4);
          Text: "Energy: 0 / 0";
        }

        Label #BatteryTransfer {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Max Transfer: 0 J/s";
        }

        Group {
          Anchor: (Height: 8);
        }

        // The following labels show upgrade tier and related statistics.
        Label #BatteryNextTier {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Text: "Next: Reinforced";
        }

        Label #BatteryUpgradeStats {
          Style: (
            FontSize: 13,
            TextColor: #96a9be,
            Wrap: true
          );
          Anchor: (Left: 0, Right: 0);
          Padding: (Top: 4);
          Text: "";
        }

        Label #UpgradeReqHeader {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Padding: (Top: 10);
          Text: "Requirements";
        }

        Group {
          LayoutMode: Top;
          Padding: (Top: 6);

          // Each requirement row contains an item icon, name, and quantity.
          Group #UpgradeReqRow1 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);

            ItemSlot #UpgradeReqSlot1 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName1 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty1 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow2 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot2 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName2 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty2 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow3 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot3 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName3 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty3 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow4 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot4 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName4 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty4 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          // Empty-state message used when there are no upgrade requirements.
          Label #UpgradeReqEmpty {
            Style: (
              FontSize: 13,
              TextColor: #96a9be
            );
            Padding: (Top: 6);
            Text: "No further upgrades.";
            Visible: false;
          }
        }

        Group { Anchor: (Height: 8); }

        // The page binds this button to its upgrade action.
        $C.@TextButton #UpgradeButton {
          Anchor: (Left: 0, Right: 0, Height: 34);
          Text: "Upgrade";
        }

        Group { Anchor: (Height: 10); }

        // Battery face controls below select the side modes.
        Label #SideHeader {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Text: "Sides";
        }

        $C.@SmallSecondaryTextButton #SideEast {
          Padding: (Top: 4);
          Text: "East: Off";
        }

        $C.@SmallSecondaryTextButton #SideWest {
          Padding: (Top: 2);
          Text: "West: Off";
        }

        $C.@SmallSecondaryTextButton #SideUp {
          Padding: (Top: 2);
          Text: "Up: Off";
        }

        $C.@SmallSecondaryTextButton #SideDown {
          Padding: (Top: 2);
          Text: "Down: Off";
        }

        $C.@SmallSecondaryTextButton #SideSouth {
          Padding: (Top: 2);
          Text: "South: Off";
        }

        $C.@SmallSecondaryTextButton #SideNorth {
          Padding: (Top: 2);
          Text: "North: Off";
        }
      }
    }
  }
}

$C.@BackButton {}
