$C = "Common.ui";
// Import shared styling tokens used by the filter panel.
$M = "HyProTech_Master.ui";
@IconSize = 64;
@SideButtonWidth = 280;
@RenameButtonWidth = 90;
@FilterButtonWidth = 64;
@FilterButtonHeight = 32;
@FilterButtonIconSize = 16;
@FilterIconSize = 24;
@PanelBorderColor = $M.@PanelBorderColor;
@PanelFillColor = $M.@PanelFillColor;
@PanelDividerColor = $M.@PanelDividerColor;
@FilterPanelWidth = 1200;
@FilterPanelHeight = 780;
@FilterPanelInnerHeight = 756;
@FilterSidebarWidth = 280;
@FilterMainWidth = 880;
@FilterSidebarContentWidth = 248;
@FilterSectionBg = #0b1623(0.5);
@FilterRowHeight = 32;
@FilterItemCheckSize = 24;
@FilterButtonIcon = Group {
  Anchor: (Width: @FilterButtonIconSize, Height: @FilterButtonIconSize);
  Background: "TexturesUI/filter.png";
};

// Item cable page with directional, rename, and filter controls for each face.
$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 560, Height: 700);

    #Title {
      Group {
        $C.@Title {
          @Text = "Item Cable";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group {
        LayoutMode: Top;
        Padding: (Top: 8, Left: 8, Right: 8);

        Label #ItemHeader {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Text: "Item Transport";
        }

        // The following rows provide a side icon, mode button, optional name, and filter action.
        Label #SideHeader {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Padding: (Top: 8);
          Text: "Connections";
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 4);

          // East-side neighbor icon; the mode and optional actions follow in this row.
          ItemSlot #SideEastIcon {
            Anchor: (Width: @IconSize, Height: @IconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideEast {
            Anchor: (Width: @SideButtonWidth);
            Text: "East: Off";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideEastRename {
            Anchor: (Width: @RenameButtonWidth, Height: @FilterButtonHeight);
            Text: "Name";
            Visible: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          Button #SideEastFilter {
            Anchor: (Width: @FilterButtonWidth, Height: @FilterButtonHeight);
            Style: $C.@TertiaryButtonStyle;
            LayoutMode: Center;

            @FilterButtonIcon {}
          }
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 2);

          // West-side neighbor icon, direction mode, storage rename, and filter actions.
          ItemSlot #SideWestIcon {
            Anchor: (Width: @IconSize, Height: @IconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideWest {
            Anchor: (Width: @SideButtonWidth);
            Text: "West: Off";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideWestRename {
            Anchor: (Width: @RenameButtonWidth, Height: @FilterButtonHeight);
            Text: "Name";
            Visible: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          Button #SideWestFilter {
            Anchor: (Width: @FilterButtonWidth, Height: @FilterButtonHeight);
            Style: $C.@TertiaryButtonStyle;
            LayoutMode: Center;

            @FilterButtonIcon {}
          }
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 2);

          // Up-side neighbor icon, direction mode, storage rename, and filter actions.
          ItemSlot #SideUpIcon {
            Anchor: (Width: @IconSize, Height: @IconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideUp {
            Anchor: (Width: @SideButtonWidth);
            Text: "Up: Off";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideUpRename {
            Anchor: (Width: @RenameButtonWidth, Height: @FilterButtonHeight);
            Text: "Name";
            Visible: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          Button #SideUpFilter {
            Anchor: (Width: @FilterButtonWidth, Height: @FilterButtonHeight);
            Style: $C.@TertiaryButtonStyle;
            LayoutMode: Center;

            @FilterButtonIcon {}
          }
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 2);

          // Down-side neighbor icon, direction mode, storage rename, and filter actions.
          ItemSlot #SideDownIcon {
            Anchor: (Width: @IconSize, Height: @IconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideDown {
            Anchor: (Width: @SideButtonWidth);
            Text: "Down: Off";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideDownRename {
            Anchor: (Width: @RenameButtonWidth, Height: @FilterButtonHeight);
            Text: "Name";
            Visible: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          Button #SideDownFilter {
            Anchor: (Width: @FilterButtonWidth, Height: @FilterButtonHeight);
            Style: $C.@TertiaryButtonStyle;
            LayoutMode: Center;

            @FilterButtonIcon {}
          }
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 2);

          // South-side neighbor icon, direction mode, storage rename, and filter actions.
          ItemSlot #SideSouthIcon {
            Anchor: (Width: @IconSize, Height: @IconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideSouth {
            Anchor: (Width: @SideButtonWidth);
            Text: "South: Off";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideSouthRename {
            Anchor: (Width: @RenameButtonWidth, Height: @FilterButtonHeight);
            Text: "Name";
            Visible: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          Button #SideSouthFilter {
            Anchor: (Width: @FilterButtonWidth, Height: @FilterButtonHeight);
            Style: $C.@TertiaryButtonStyle;
            LayoutMode: Center;

            @FilterButtonIcon {}
          }
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 2);

          // North-side neighbor icon, direction mode, storage rename, and filter actions.
          ItemSlot #SideNorthIcon {
            Anchor: (Width: @IconSize, Height: @IconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideNorth {
            Anchor: (Width: @SideButtonWidth);
            Text: "North: Off";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #SideNorthRename {
            Anchor: (Width: @RenameButtonWidth, Height: @FilterButtonHeight);
            Text: "Name";
            Visible: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          Button #SideNorthFilter {
            Anchor: (Width: @FilterButtonWidth, Height: @FilterButtonHeight);
            Style: $C.@TertiaryButtonStyle;
            LayoutMode: Center;

            @FilterButtonIcon {}
          }
        }

        Group {
          LayoutMode: Top;
          Padding: (Top: 10);

          // Overall cable mode, inventory target, and connected-network settings.
          $C.@SmallSecondaryTextButton #ItemMode {
            Text: "Item Mode: Take/Put";
            Visible: false;
          }

          $C.@SmallSecondaryTextButton #ItemTarget {
            Text: "Target: Auto";
          }

          $C.@SmallSecondaryTextButton #ItemNetwork {
            Text: "Priority Network";
          }
        }
      }
    }
  }
}

// Initially hidden overlay for editing a side's item filter.
Group #FilterPanel {
  Anchor: (Full: 0);
  Background: #000000(0.65);
  Visible: false;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Center;

    Group #FilterPanelBody {
      Anchor: (Width: @FilterPanelWidth, Height: @FilterPanelHeight);
      Background: @PanelBorderColor;
      Padding: (Full: 1);

      Group {
        Anchor: (Full: 0);
        Background: @PanelFillColor;
        Padding: (Top: 12, Bottom: 12, Left: 12, Right: 12);
        LayoutMode: Left;

        // Sidebar contains category selection and named preset controls.
        Group #FilterSidebar {
          Anchor: (Width: @FilterSidebarWidth, Height: @FilterPanelInnerHeight);
          Background: @PanelBorderColor;
          Padding: (Full: 1);

          Group {
            Anchor: (Full: 0);
            Background: @PanelFillColor;
            Padding: (Top: 10, Left: 10, Right: 10, Bottom: 10);
            LayoutMode: Top;

            Label #FilterSidebarTitle {
              Style: (
                FontSize: 16,
                RenderBold: true,
                TextColor: #d6cfb2
              );
              Text: "Categories";
            }

            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
            Group { Anchor: (Height: 8); }

            // Category buttons narrow the catalog shown in the filter list.
            $C.@SmallSecondaryTextButton #FilterCategoryAll { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "All"; }
            $C.@SmallSecondaryTextButton #FilterCategoryOres { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Ores"; }
            $C.@SmallSecondaryTextButton #FilterCategoryIngots { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Ingots"; }
            $C.@SmallSecondaryTextButton #FilterCategoryPlates { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Plates"; }
            $C.@SmallSecondaryTextButton #FilterCategoryComponents { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Components"; }
            $C.@SmallSecondaryTextButton #FilterCategoryMachines { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Machines"; }
            $C.@SmallSecondaryTextButton #FilterCategoryCables { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Cables"; }
            $C.@SmallSecondaryTextButton #FilterCategoryFluids { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Fluids"; }
            $C.@SmallSecondaryTextButton #FilterCategoryNuclear { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Nuclear"; }
            $C.@SmallSecondaryTextButton #FilterCategoryOther { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Other"; }

          Group { Anchor: (Height: 10); }
          Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
          Group { Anchor: (Height: 8); }

            Label #FilterPresetHeader {
              Style: (
                FontSize: 16,
                RenderBold: true,
                TextColor: #d6cfb2
              );
              Text: "Presets";
            }

          // Named presets store the active side's selected filter items.
          CompactTextField #FilterPresetNameInput {
            Anchor: (Width: @FilterSidebarContentWidth, Height: 34, Vertical: 0);
            CollapsedWidth: @FilterSidebarContentWidth;
            ExpandedWidth: @FilterSidebarContentWidth;
          PlaceholderText: "Preset name...";
          Style: (FontSize: 13);
          PlaceholderStyle: (TextColor: #3d5a85, FontSize: 12);
          Padding: (Horizontal: 8, Left: 8);
        }

          $C.@SmallSecondaryTextButton #FilterPresetSave {
            Anchor: (Width: @FilterSidebarContentWidth, Height: 32);
            Text: "Save preset";
          }

          $C.@SmallSecondaryTextButton #FilterPresetOres {
            Anchor: (Width: @FilterSidebarContentWidth, Height: 32);
            Text: "Preset: Ores";
          }

        Group #FilterPresetSlots {
          LayoutMode: Top;
          Padding: (Top: 4);

            $C.@SmallSecondaryTextButton #FilterPresetSlot0 { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Preset 1"; }
            $C.@SmallSecondaryTextButton #FilterPresetSlot1 { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Preset 2"; }
            $C.@SmallSecondaryTextButton #FilterPresetSlot2 { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Preset 3"; }
            $C.@SmallSecondaryTextButton #FilterPresetSlot3 { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Preset 4"; }
            $C.@SmallSecondaryTextButton #FilterPresetSlot4 { Anchor: (Width: @FilterSidebarContentWidth, Height: 32); Text: "Preset 5"; }
          }
          }
        }

      Group {
        Anchor: (Width: 12);
      }

        // Main area contains category, search, filter items, and paging controls.
        Group #FilterMain {
        Anchor: (Width: @FilterMainWidth, Height: @FilterPanelInnerHeight);
        Background: @PanelBorderColor;
        Padding: (Full: 1);

        Group {
          Anchor: (Full: 0);
          Background: @PanelFillColor;
          Padding: (Top: 12, Left: 12, Right: 12, Bottom: 12);
          LayoutMode: Top;

          Label #FilterTitle {
          Style: (
            FontSize: 22,
            RenderBold: true,
            TextColor: #d6cfb2
          );
          Text: "Filters";
        }

        Label #FilterHint {
          Style: (
            FontSize: 14,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Select items to allow";
        }

          Group #FilterCategoryRow {
            Anchor: (Height: 28);
            LayoutMode: Left;
            Padding: (Top: 6);

            Label #FilterCategoryLabel {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Anchor: (Width: 90, Vertical: 0);
              Text: "Category";
            }

          Group {
            Anchor: (Width: 6);
          }

          Label #FilterCategoryValue {
            Style: (
              FontSize: 13,
              TextColor: #c7b59a,
              RenderBold: true
            );
            Anchor: (Vertical: 0);
            Text: "All";
          }
        }

          // The mode checkbox selects whether listed items are allowed or blocked.
          Group #FilterModeRow {
            Anchor: (Height: 38);
            LayoutMode: Left;
            Padding: (Top: 6);

            Label #FilterModeLabel {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Anchor: (Width: 90, Vertical: 0);
              Text: "Mode";
            }

          Group {
            Anchor: (Width: 6);
          }

            $C.@CheckBox #FilterModeCheck {
              Anchor: (Width: 36, Height: 36, Vertical: 0);
            }

          Group {
            Anchor: (Width: 6);
          }

            Label #FilterModeValue {
              Style: (
                FontSize: 13,
                TextColor: #c7b59a,
                RenderBold: true
              );
              Anchor: (Vertical: 0);
              Text: "Blacklist";
            }
          }

          // Search text filters the item catalog by item ID or display name.
          Group #FilterSearchRow {
            Anchor: (Height: 44);
            LayoutMode: Left;
            Padding: (Top: 8);

            Label #FilterSearchLabel {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Anchor: (Width: 90, Vertical: 0);
              Text: "Search";
            }

            Group {
              Anchor: (Width: 6);
            }

            CompactTextField #FilterSearchInput {
              Anchor: (Width: 400, Height: 34, Vertical: 0);
              CollapsedWidth: 400;
              ExpandedWidth: 400;
              PlaceholderText: "Search items...";
              Style: (FontSize: 14);
              PlaceholderStyle: (TextColor: #3d5a85, FontSize: 13);
              Padding: (Horizontal: 10, Left: 26);
              Decoration: (
                Default: (
                  Icon: (Texture: "Common/SearchIcon.png", Width: 14, Height: 14, Offset: 6),
                  ClearButtonStyle: $C.@ClearButtonStyle
                )
              );
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@SmallSecondaryTextButton #FilterSearchButton {
              Anchor: (Width: 130, Height: 34, Vertical: 0);
              Text: "Find";
            }
          }

          // The text field and copy/paste controls exchange filter selections as text.
          Group #FilterPresetRow {
            Anchor: (Height: 44);
            LayoutMode: Left;
            Padding: (Top: 6);

            Label #FilterPresetLabel {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Anchor: (Width: 90, Vertical: 0);
              Text: "Clipboard";
            }

            Group {
              Anchor: (Width: 6);
            }

            CompactTextField #FilterPresetText {
              Anchor: (Width: 400, Height: 34, Vertical: 0);
              CollapsedWidth: 400;
              ExpandedWidth: 400;
              PlaceholderText: "Paste items (comma separated)...";
              Style: (FontSize: 13);
              PlaceholderStyle: (TextColor: #3d5a85, FontSize: 12);
              Padding: (Horizontal: 10, Left: 10);
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@SmallSecondaryTextButton #FilterPresetCopy {
              Anchor: (Width: 110, Height: 34, Vertical: 0);
              Text: "Copy";
            }

            Group {
              Anchor: (Width: 4);
            }

            $C.@SmallSecondaryTextButton #FilterPresetPaste {
              Anchor: (Width: 110, Height: 34, Vertical: 0);
              Text: "Paste";
            }

            Group {
              Anchor: (Width: 4);
            }

            $C.@SmallSecondaryTextButton #FilterPresetClear {
              Anchor: (Width: 110, Height: 34, Vertical: 0);
              Text: "Clear";
            }
          }

        // The server reveals this message when the filtered catalog has no matching items.
        Label #FilterEmpty {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 8);
          Text: "No items available";
          Visible: false;
        }

          // Repeated rows below are populated with items and their selection state.
          Group #FilterList {
            Anchor: (Left: 0, Right: 0);
            LayoutMode: Top;
            Background: @FilterSectionBg;
            Padding: (Top: 6, Left: 8, Right: 8, Bottom: 8);

          Group #FilterRow0 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Background: #0b1623(0.25);
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem0Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem0Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem0Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow1 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem1Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem1Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem1Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow2 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Background: #0b1623(0.25);
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem2Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem2Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem2Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow3 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem3Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem3Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem3Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow4 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Background: #0b1623(0.25);
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem4Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem4Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem4Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow5 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem5Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem5Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem5Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow6 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Background: #0b1623(0.25);
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem6Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem6Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem6Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow7 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem7Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem7Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem7Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow8 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Background: #0b1623(0.25);
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem8Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem8Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem8Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow9 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem9Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem9Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem9Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow10 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Background: #0b1623(0.25);
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem10Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem10Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem10Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }

          Group #FilterRow11 {
            Anchor: (Left: 0, Right: 0, Height: @FilterRowHeight);
            LayoutMode: Left;
            Padding: (Top: 2);
            Visible: false;

            ItemSlot #FilterItem11Icon {
              Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
              ShowQualityBackground: false;
              ShowQuantity: false;
            }

            Group {
              Anchor: (Width: 6);
            }

            $C.@CheckBox #FilterItem11Check {
              Anchor: (Width: @FilterItemCheckSize, Height: @FilterItemCheckSize, Vertical: 0);
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #FilterItem11Label {
              Style: (
                FontSize: 14,
                TextColor: #c7b59a
              );
              Text: "-";
            }
          }
        }

        // Page controls navigate the filtered item list.
        Group #FilterPaging {
          Anchor: (Height: 32);
          LayoutMode: Left;
          Padding: (Top: 10);

          $C.@SmallSecondaryTextButton #FilterPrev {
            Anchor: (Width: 90, Height: 30);
            Text: "Prev";
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@SmallSecondaryTextButton #FilterNext {
            Anchor: (Width: 90, Height: 30);
            Text: "Next";
          }

          Group {
            Anchor: (Width: 8);
          }

          Label #FilterPage {
            Style: (
              FontSize: 13,
              TextColor: #96a9be
            );
            Text: "0 / 0";
          }
        }

        Group { Anchor: (Height: 8); }

        Group {
          LayoutMode: Center;
          Padding: (Top: 10);

          $C.@TextButton #FilterClose {
            Anchor: (Width: 180, Height: 36);
            Text: "Close";
          }
        }
        }
      }
    }
  }
}
}

$C.@BackButton {}

// Initially hidden overlay used to edit a storage name.
Group #RenamePanel {
  Anchor: (Full: 0);
  Background: #000000(0.55);
  Visible: false;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Center;

    Group #RenamePanelBody {
      Anchor: (Width: 340, Height: 180);
      Background: $C.@InputBoxBackground;
      Padding: (Top: 10, Bottom: 10, Left: 12, Right: 12);
      LayoutMode: Top;

      Label #RenameTitle {
        Style: (
          FontSize: 16,
          RenderBold: true,
          TextColor: #d6cfb2
        );
        Text: "Storage Name";
      }

      // The page saves this text as the connected storage's custom name.
      CompactTextField #RenameInput {
        Anchor: (Width: 280, Height: 30, Vertical: 0);
        CollapsedWidth: 280;
        ExpandedWidth: 280;
        PlaceholderText: "Enter name...";
        Style: (FontSize: 14);
        PlaceholderStyle: (TextColor: #3d5a85, FontSize: 13);
        Padding: (Horizontal: 10, Left: 10);
      }

      Group {
        Anchor: (Height: 10);
      }

      Group {
        LayoutMode: Left;

        $C.@SmallSecondaryTextButton #RenameSave {
          Anchor: (Width: 120);
          Text: "Save";
        }

        Group {
          Anchor: (Width: 8);
        }

        $C.@SmallSecondaryTextButton #RenameCancel {
          Anchor: (Width: 120);
          Text: "Cancel";
        }
      }
    }
  }
}
