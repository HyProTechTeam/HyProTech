$C = "Common.ui";
// Shared sizing and color tokens for this machine layout.
$M = "HyProTech_Master.ui";
@ReqSlotSize = $M.@ReqSlotSize;
@ItemSlotSize = $M.@ItemSlotSize;
@ItemSlotInner = $M.@ItemSlotInner;
@SlotBorderColor = $M.@SlotBorderColor;
@SlotInnerColor = $M.@SlotInnerColor;
@InvSlotSize = $M.@InvSlotSize;
@InvSlotGap = $M.@InvSlotGap;
@InvSlotBorder = $M.@InvSlotBorder;
@InvSlotInner = $M.@InvSlotInner;
@InvGridHeight = $M.@InvGridHeight;
@PanelBorderColor = $M.@PanelBorderColor;
@PanelFillColor = $M.@PanelFillColor;
@PanelDividerColor = $M.@PanelDividerColor;
@LeftColumnWidth = $M.@LeftColumnWidth;
@RightColumnWidth = $M.@RightColumnWidth;
@PanelGap = $M.@PanelGap;

// Alloy smelter layout; the matching Java page populates data and binds actions.
$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 1000, Height: 940);

    #Title {
      Group {
        $C.@Title {
          @Text = "Alloy Smelter";
        }
      }
    }

    #Content {
      LayoutMode: Left;
      Padding: (Top: 12, Left: 12, Right: 12, Bottom: 12);

      Group #LeftColumn {
        Anchor: (Width: @LeftColumnWidth);
        LayoutMode: Top;

        // Recipe selector and the hidden machine inventory grids.
        Group #InputPanel {
          Anchor: (Left: 0, Right: 0);
          Background: @PanelBorderColor;
          Padding: (Full: 1);

          Group {
            Anchor: (Full: 0);
            Background: @PanelFillColor;
            LayoutMode: Top;
            Padding: (Top: 8, Left: 12, Right: 12, Bottom: 8);

            Label {
              Style: (
                FontSize: 14,
                RenderBold: true,
                TextColor: #c7b59a
              );
              Text: "Recipe Selector";
            }

            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
            Group { Anchor: (Height: 8); }

            Group {
              LayoutMode: Top;
              Anchor: (Left: 0, Right: 0);

              // Clicking an icon selects a recipe whose details are shown below.
              ItemGrid #RecipeGrid {
                Anchor: (Left: 0, Right: 0, Height: 260);
                SlotsPerRow: 4;
                AreItemsDraggable: false;
                ShowScrollbar: true;
                InfoDisplay: None;
                RenderItemQualityBackground: false;
                Style: (
                  SlotSize: @InvSlotSize,
                  SlotIconSize: @InvSlotSize,
                  SlotSpacing: @InvSlotGap,
                  SlotBackground: "Common/BlockSelectorSlotBackground.png"
                );
              }

              Group { Anchor: (Height: 6); }

              Label #RecipeGridHint {
                Style: (
                  FontSize: 12,
                  TextColor: #96a9be,
                  Wrap: true
                );
                Anchor: (Left: 0, Right: 0);
                Text: "Select an alloy to load inputs from your inventory.";
              }
            }

            Group { Anchor: (Height: 8); }

            // Machine grids are initially hidden and can be controlled by page logic.
            Group #HiddenMachineGrids {
              Anchor: (Left: 0, Right: 0, Height: 108);
              LayoutMode: Top;
              Visible: false;

              Group {
                LayoutMode: Center;
                Anchor: (Left: 0, Right: 0, Height: 84);

                Group {
                  LayoutMode: Left;
                  Anchor: (Width: 424, Height: 92);

                  // The page fills this grid from the machine's input container slots.
                  ItemGrid #InputGrid {
                    Anchor: (Width: 92, Height: 92);
                    SlotsPerRow: 2;
                    AreItemsDraggable: true;
                    ShowScrollbar: false;
                    InfoDisplay: None;
                    RenderItemQualityBackground: false;
                    Style: (
                      SlotSize: @ItemSlotInner,
                      SlotIconSize: @ItemSlotInner,
                      SlotSpacing: 4,
                      SlotBackground: "Common/BlockSelectorSlotBackground.png"
                    );
                  }

                  Group { Anchor: (Width: 10); }

                  Label {
                    Anchor: (Width: 24, Height: 44);
                    Style: (
                      FontSize: 18,
                      RenderBold: true,
                      TextColor: #96a9be,
                      HorizontalAlignment: Center,
                      VerticalAlignment: Center
                    );
                    Text: "->";
                  }

                  Group { Anchor: (Width: 10); }

                  // The page fills this grid from the machine's output container slots.
                  ItemGrid #OutputGrid {
                    Anchor: (Width: 288, Height: 44);
                    SlotsPerRow: 6;
                    AreItemsDraggable: true;
                    ShowScrollbar: false;
                    InfoDisplay: None;
                    RenderItemQualityBackground: false;
                    Style: (
                      SlotSize: @ItemSlotInner,
                      SlotIconSize: @ItemSlotInner,
                      SlotSpacing: 4,
                      SlotBackground: "Common/BlockSelectorSlotBackground.png"
                    );
                  }
                }
              }

              Group { Anchor: (Height: 4); }

              Group {
                LayoutMode: Center;
                Anchor: (Left: 0, Right: 0, Height: 26);

                // Move available input stacks back to the player's inventory.
                $C.@SmallSecondaryTextButton #TakeInputButton {
                  Anchor: (Width: 140, Height: 26);
                  Text: "Take Input";
                }

                Group { Anchor: (Width: 8); }

                // Collect available machine output into the player's inventory.
                $C.@SmallSecondaryTextButton #TakeOutputButton {
                  Anchor: (Width: 140, Height: 26);
                  Text: "Take Output";
                }
              }
            }
          }
        }

        Group { Anchor: (Height: @PanelGap); }

        // Selected recipe details, requirements, quantity, and player inventory grid.
        Group #InventoryPanel {
          Anchor: (Left: 0, Right: 0);
          Background: @PanelBorderColor;
          Padding: (Full: 1);

          Group {
            Anchor: (Full: 0);
            Background: @PanelFillColor;
            LayoutMode: Top;
            Padding: (Top: 8, Left: 12, Right: 12, Bottom: 8);

            Label {
              Style: (
                FontSize: 14,
                RenderBold: true,
                TextColor: #c7b59a
              );
              Text: "Recipe Details";
            }

            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
            Group { Anchor: (Height: 8); }

            // Placeholder shown when no recipe details are selected.
            Group #RecipeDetailsEmpty {
              Anchor: (Left: 0, Right: 0, Height: 22);
              LayoutMode: Center;

              Label #RecipeEmptyText {
                Style: (
                  FontSize: 12,
                  TextColor: #96a9be
                );
                Text: "Select a recipe to see requirements.";
              }
            }

            // Recipe details include ingredient rows and quantity controls.
            Group #RecipeDetails {
              LayoutMode: Top;
              Anchor: (Left: 0, Right: 0);
              Visible: false;

              Group {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 36);

                ItemSlot #RecipeOutputSlot {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #RecipeOutputName {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #RecipeOutputQty {
                  Anchor: (Width: 80);
                  Style: (
                    FontSize: 12,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group { Anchor: (Height: 6); }

              Group #RecipeReqRow1 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 28);

                ItemSlot #RecipeReqSlot1 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #RecipeReqText1 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 12,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }
              }

              Group #RecipeReqRow2 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 28);
                Padding: (Top: 4);

                ItemSlot #RecipeReqSlot2 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #RecipeReqText2 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 12,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }
              }

              Group #RecipeReqRow3 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 28);
                Padding: (Top: 4);

                ItemSlot #RecipeReqSlot3 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #RecipeReqText3 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 12,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }
              }

              Group #RecipeReqRow4 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 28);
                Padding: (Top: 4);

                ItemSlot #RecipeReqSlot4 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #RecipeReqText4 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 12,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }
              }

              Group { Anchor: (Height: 8); }

              // Quantity controls adjust how many copies of the selected recipe to load.
              Group #RecipeQtyRow {
                LayoutMode: Top;
                Anchor: (Left: 0, Right: 0, Height: 58);

                Group {
                  LayoutMode: Left;
                  Anchor: (Left: 0, Right: 0, Height: 26);

                  $C.@SmallSecondaryTextButton #RecipeQtyMinus {
                    Anchor: (Width: 32, Height: 26);
                    Text: "-";
                  }

                  Group { Anchor: (Width: 6); }

                  Label #RecipeQtyLabel {
                    Anchor: (Width: 44, Height: 26);
                    Style: (
                      FontSize: 12,
                      TextColor: #c7b59a,
                      HorizontalAlignment: Center
                    );
                    Text: "x1";
                  }

                  Group { Anchor: (Width: 6); }

                  $C.@SmallSecondaryTextButton #RecipeQtyPlus {
                    Anchor: (Width: 32, Height: 26);
                    Text: "+";
                  }

                  Group { Anchor: (Width: 8); }

                  $C.@SmallSecondaryTextButton #RecipeQtyPlusTen {
                    Anchor: (Width: 50, Height: 26);
                    Text: "+10";
                  }

                  Group { Anchor: (Width: 6); }

                  $C.@SmallSecondaryTextButton #RecipeQtyAll {
                    Anchor: (Width: 50, Height: 26);
                    Text: "ALL";
                  }
                }

                Group { Anchor: (Height: 6); }

                Group {
                  LayoutMode: Center;
                  Anchor: (Left: 0, Right: 0, Height: 26);

                  // Request insertion of the selected recipe's ingredients into the machine.
                  $C.@SmallSecondaryTextButton #RecipeConfirmButton {
                    Anchor: (Width: 140, Height: 26);
                    Text: "Load Recipe";
                  }
                }
              }

              Group { Anchor: (Height: 6); }

              // The page displays requested and available recipe materials here.
              Label #RecipeCostText {
                Style: (
                  FontSize: 12,
                  TextColor: #96a9be,
                  Wrap: true
                );
                Anchor: (Left: 0, Right: 0);
                Text: "";
              }
            }

            Group #HiddenInventoryGrid {
              Anchor: (Height: 0);
              Visible: false;

              ItemGrid #PlayerInventoryGrid {
                Anchor: (Left: 0, Right: 0, Height: 0);
                SlotsPerRow: 9;
                AreItemsDraggable: true;
                RenderItemQualityBackground: false;
                InfoDisplay: None;
                Style: (
                  SlotSize: @InvSlotSize,
                  SlotIconSize: @InvSlotSize,
                  SlotSpacing: @InvSlotGap,
                  SlotBackground: "Common/BlockSelectorSlotBackground.png"
                );
              }
            }
          }
        }
        Group { Anchor: (Height: @PanelGap); }
        // Bonus rows display configured secondary outputs.
        Group #BonusPanel {
          Anchor: (Left: 0, Right: 0);
          Background: @PanelBorderColor;
          Padding: (Full: 1);

          Group {
            Anchor: (Full: 0);
            Background: @PanelFillColor;
            LayoutMode: Top;
            Padding: (Top: 8, Left: 12, Right: 12, Bottom: 8);

            Label #BonusHeader {
              Style: (
                FontSize: 14,
                RenderBold: true,
                TextColor: #c7b59a
              );
              Text: "Bonus Drops";
            }

            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
            Group { Anchor: (Height: 8); }

            Group {
              LayoutMode: Top;

              Group #BonusRow1 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 32);

                ItemSlot #BonusSlot1 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #BonusName1 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #BonusChance1 {
                  Anchor: (Width: 60);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #BonusRow2 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 32);
                Padding: (Top: 4);

                ItemSlot #BonusSlot2 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #BonusName2 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #BonusChance2 {
                  Anchor: (Width: 60);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #BonusRow3 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 32);
                Padding: (Top: 4);

                ItemSlot #BonusSlot3 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #BonusName3 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #BonusChance3 {
                  Anchor: (Width: 60);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #BonusRow4 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 32);
                Padding: (Top: 4);

                ItemSlot #BonusSlot4 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #BonusName4 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #BonusChance4 {
                  Anchor: (Width: 60);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #BonusRow5 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 32);
                Padding: (Top: 4);

                ItemSlot #BonusSlot5 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #BonusName5 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #BonusChance5 {
                  Anchor: (Width: 60);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              // Placeholder shown when the current input has no displayed bonus drops.
              Label #BonusEmpty {
                Style: (
                  FontSize: 13,
                  TextColor: #96a9be
                );
                Padding: (Top: 6);
                Text: "";
                Visible: false;
              }
            }
          }
        }

      }

      Group { Anchor: (Width: 16); }

      Group #RightColumn {
        Anchor: (Width: @RightColumnWidth);
        LayoutMode: Top;

        // Machine tier, energy, and processing state are displayed here.
        Group #StatusPanel {
          Anchor: (Left: 0, Right: 0);
          Background: @PanelBorderColor;
          Padding: (Full: 1);

          Group {
            Anchor: (Full: 0);
            Background: @PanelFillColor;
            LayoutMode: Top;
            Padding: (Top: 8, Left: 12, Right: 12, Bottom: 8);

            Label #CrusherTier {
              Style: (
                FontSize: 16,
                RenderBold: true,
                TextColor: #d6cfb2
              );
              Text: "Tier: Basic";
            }

            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
            Group { Anchor: (Height: 8); }

            Label #CrusherEnergy {
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                Wrap: true
              );
              Anchor: (Left: 0, Right: 0);
              Padding: (Top: 4);
              Text: "Energy: 0 / 0";
            }

            Label #CrusherConsumption {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Padding: (Top: 2);
              Text: "Consumption: 0 J/s";
            }

            Label #CrusherProgress {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Padding: (Top: 2);
              Text: "Progress: 0%";
            }

            Label #CrusherYield {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Padding: (Top: 2);
              Text: "Yield: 2x";
            }

            Label #CrusherStatus {
              Style: (
                FontSize: 13,
                TextColor: #96a9be
              );
              Padding: (Top: 2);
              Text: "Status: ON";
            }

            Group {
              LayoutMode: Left;
              Padding: (Top: 6);

              $C.@SmallSecondaryTextButton #CrusherToggleButton {
                Anchor: (Width: 120, Height: 26);
                Text: "TURN OFF";
              }
            }
          }
        }

        Group { Anchor: (Height: @PanelGap); }

        // Upgrade panel contains the next tier information and material requirement rows.
        Group #UpgradePanel {
          Anchor: (Left: 0, Right: 0);
          Background: @PanelBorderColor;
          Padding: (Full: 1);

          Group {
            Anchor: (Full: 0);
            Background: @PanelFillColor;
            LayoutMode: Top;
            Padding: (Top: 8, Left: 12, Right: 12, Bottom: 8);

            Label #CrusherNextTier {
              Style: (
                FontSize: 14,
                RenderBold: true,
                TextColor: #c7b59a
              );
              Text: "Next: Reinforced";
            }

            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: @PanelDividerColor; }
            Group { Anchor: (Height: 8); }

            Label #CrusherUpgradeStats {
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                Wrap: true
              );
              Anchor: (Left: 0, Right: 0);
              Padding: (Top: 4);
              Text: "";
            }

            Label #UpgradeReqHeader {
              Style: (
                FontSize: 14,
                RenderBold: true,
                TextColor: #c7b59a
              );
              Padding: (Top: 10);
              Text: "Requirements";
            }

            Group {
              LayoutMode: Top;
              Padding: (Top: 6);

              Group #UpgradeReqRow1 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 34);

                ItemSlot #UpgradeReqSlot1 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #UpgradeReqName1 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #UpgradeReqQty1 {
                  Anchor: (Width: 70);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #UpgradeReqRow2 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 34);
                Padding: (Top: 4);

                ItemSlot #UpgradeReqSlot2 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #UpgradeReqName2 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #UpgradeReqQty2 {
                  Anchor: (Width: 70);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #UpgradeReqRow3 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 34);
                Padding: (Top: 4);

                ItemSlot #UpgradeReqSlot3 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #UpgradeReqName3 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #UpgradeReqQty3 {
                  Anchor: (Width: 70);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              Group #UpgradeReqRow4 {
                LayoutMode: Left;
                Anchor: (Left: 0, Right: 0, Height: 34);
                Padding: (Top: 4);

                ItemSlot #UpgradeReqSlot4 {
                  Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
                  ShowQualityBackground: false;
                  HitTestVisible: false;
                }

                Group { Anchor: (Width: 8); }

                Label #UpgradeReqName4 {
                  FlexWeight: 1;
                  Style: (
                    FontSize: 13,
                    TextColor: #c7b59a
                  );
                  Text: "";
                }

                Label #UpgradeReqQty4 {
                  Anchor: (Width: 70);
                  Style: (
                    FontSize: 13,
                    TextColor: #96a9be,
                    HorizontalAlignment: End
                  );
                  Text: "";
                }
              }

              // Placeholder shown when the current tier has no further upgrade.
              Label #UpgradeReqEmpty {
                Style: (
                  FontSize: 13,
                  TextColor: #96a9be
                );
                Padding: (Top: 6);
                Text: "No further upgrades.";
                Visible: false;
              }
            }

            Group { Anchor: (Height: 8); }

            // Submit the upgrade request using the materials listed above.
            $C.@TextButton #UpgradeButton {
              Anchor: (Left: 0, Right: 0, Height: 34);
              Text: "Upgrade";
            }
          }
        }

      }
    }

  }
}

$C.@BackButton {}
