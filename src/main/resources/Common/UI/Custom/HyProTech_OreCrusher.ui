$C = "Common.ui";
@ReqSlotSize = 32;
@ItemSlotSize = 40;

// Ore-crusher page with input/output slots, status, and upgrade controls.
$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 1000, Height: 480);

    #Title {
      Group {
        $C.@Title {
          @Text = "Ore Crusher";
        }
      }
    }

    #Content {
      LayoutMode: Left;

      Group {
        Anchor: (Width: 300);
        LayoutMode: Top;
        Padding: (Top: 10, Left: 8, Right: 8);

        Label {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Text: "Input / Output";
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 10);

          Group {
            Anchor: (Width: @ItemSlotSize, Height: @ItemSlotSize);
            LayoutMode: Full;
            // Input icon and its overlaid quantity.
            ItemSlot #InputSlot {
              Anchor: (Full: 0);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }
            Group {
              LayoutMode: Right;
              Anchor: (Width: @ItemSlotSize, Top: 24);
              Label #InputQty {
                Style: (
                  FontSize: 11,
                  HorizontalAlignment: End,
                  TextColor: #ffffff
                );
                Text: "";
              }
            }
          }

          Group { Anchor: (Width: 16); }

          Label {
            Style: (
              FontSize: 18,
              TextColor: #c7b59a
            );
            Text: "->";
          }

          Group { Anchor: (Width: 16); }

          Group {
            Anchor: (Width: @ItemSlotSize, Height: @ItemSlotSize);
            LayoutMode: Full;
            // Output icon and its overlaid quantity.
            ItemSlot #OutputSlot {
              Anchor: (Full: 0);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }
            Group {
              LayoutMode: Right;
              Anchor: (Width: @ItemSlotSize, Top: 24);
              Label #OutputQty {
                Style: (
                  FontSize: 11,
                  HorizontalAlignment: End,
                  TextColor: #ffffff
                );
                Text: "";
              }
            }
          }
        }
      }

      Group { Anchor: (Width: 30); }

      Group {
        Anchor: (Width: 360);
        LayoutMode: Top;
        Padding: (Top: 10, Left: 4, Right: 4);

        // Machine tier and energy/status details are populated by the page.
        Label #CrusherTier {
          Style: (
            FontSize: 16,
            RenderBold: true,
            TextColor: #d6cfb2
          );
          Text: "Tier: Basic";
        }

        Label #CrusherEnergy {
          Style: (
            FontSize: 13,
            TextColor: #96a9be,
            Wrap: true
          );
          Anchor: (Left: 0, Right: 0);
          Padding: (Top: 4);
          Text: "Energy: 0 / 0";
        }

        Label #CrusherConsumption {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Consumption: 0 J/s";
        }

        Label #CrusherProgress {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Progress: 0%";
        }

        Label #CrusherYield {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Yield: 2x";
        }

        Label #CrusherStatus {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Status: ON";
        }

        Group {
          LayoutMode: Left;
          Padding: (Top: 4);

          $C.@SmallSecondaryTextButton #CrusherToggleButton {
            Anchor: (Width: 120, Height: 26);
            Text: "TURN OFF";
          }
        }
      }

      Group { Anchor: (Width: 24); }

      Group {
        Anchor: (Width: 260);
        LayoutMode: Top;
        Padding: (Top: 10, Left: 4, Right: 8);

        Label #CrusherNextTier {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Text: "Next: Reinforced";
        }

        Label #CrusherUpgradeStats {
          Style: (
            FontSize: 13,
            TextColor: #96a9be,
            Wrap: true
          );
          Anchor: (Left: 0, Right: 0);
          Padding: (Top: 4);
          Text: "";
        }

        Label #UpgradeReqHeader {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Padding: (Top: 10);
          Text: "Requirements";
        }

        Group {
          LayoutMode: Top;
          Padding: (Top: 6);

          Group #UpgradeReqRow1 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);

            ItemSlot #UpgradeReqSlot1 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName1 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty1 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow2 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot2 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName2 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty2 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow3 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot3 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName3 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty3 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow4 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot4 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group { Anchor: (Width: 8); }

            Label #UpgradeReqName4 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty4 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Label #UpgradeReqEmpty {
            Style: (
              FontSize: 13,
              TextColor: #96a9be
            );
            Padding: (Top: 6);
            Text: "No further upgrades.";
            Visible: false;
          }
        }

        Group { Anchor: (Height: 8); }

        $C.@TextButton #UpgradeButton {
          Anchor: (Left: 0, Right: 0, Height: 34);
          Text: "Upgrade";
        }
      }
    }
  }
}

$C.@BackButton {}
